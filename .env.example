# ─────────────────────────────────────────────────────────────
# UPRANKLY — Environment Variables (THIS PROJECT ONLY)
# Create your own .env.local from this template.
# NEVER copy values from any other project's .env file.
# ─────────────────────────────────────────────────────────────

# UpRankly's own PostgreSQL database (a FRESH database for UpRankly only).
# Local dev:        postgresql://postgres:postgres@127.0.0.1:5432/uprankly_db
# New Supabase DB:  Settings → Database → Connection string (URI)
DATABASE_URL=

# Initial Super Admin (used once to bootstrap the first admin account).
# Change the password from Admin → Settings → Admin Account afterwards.
ADMIN_EMAIL=admin@uprankly.dev
ADMIN_PASSWORD=uprankly-admin-2024

# Gemini API key (server-side only — never expose to the browser).
# Free key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Public URL of this app (used inside the one-line integration script).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret for the /api/cron/expire scheduled cleanup endpoint.
CRON_SECRET=

# OPTIONAL — email delivery for OTP codes.
# Without this, codes use "development delivery" (shown on screen, clearly
# marked). Point this webhook at any email provider to deliver real emails.
# The server POSTs { to, subject, text } JSON to it.
OTP_EMAIL_WEBHOOK_URL=
